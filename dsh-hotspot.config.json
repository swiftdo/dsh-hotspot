{
  "projectRoot": "",
  "articleDir": "docs",
  "draftDir": "docs/draft",
  "digestDir": ".hotspot",
  "sources": [
    {
      "id": "sopilot-hottweets",
      "name": "SoPilot AI 爆款推文",
      "kind": "rss",
      "url": "https://sopilot.net/rss/hottweets"
    },
    {
      "id": "swift-org",
      "kind": "rss",
      "url": "https://www.swift.org/atom.xml"
    },
    {
      "id": "apple-swift-releases",
      "kind": "github-release",
      "repo": "apple/swift"
    },
    {
      "id": "hn-popular",
      "kind": "hn",
      "minPoints": 100
    }
  ],
  "rank": {
    "limit": 15,
    "sinceHours": 36,
    "halfLifeHours": 24,
    "clusterThreshold": 0.6
  },
  "publish": {
    "maxPerDay": 3,
    "allowedHosts": [
      "sopilot.net",
      "github.com",
      "swift.org",
      "news.ycombinator.com"
    ],
    "autoTiers": [
      "tier-1",
      "tier-2"
    ]
  }
}
